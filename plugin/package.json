{
    "name": "obsidian-chromadb-sync",
    "version": "1.0.0",
    "description": "Sync Obsidian vault to ChromaDB for semantic search",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "keywords": [
        "obsidian",
        "chromadb",
        "semantic-search",
        "vector-database"
    ],
    "devDependencies": {
        "@types/node": "^20.10.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.19.0",
        "obsidian": "latest",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    }
}
